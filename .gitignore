# Root-level launcher leftovers from the local game install
/SQ5.BAT
/sq5.ini
/*.BAT
/*.ini

# --- Re-include what we DO want ------------------------------------------
!.gitignore
!web/
!web/**
!voicestudio/
!voicestudio/**
!voicestudio/sq5_lines.db
!README.md

# --- Voicestudio runtime data (user-local, not source) -------------------
voicestudio/audiocache/
voicestudio/recordings/
voicestudio/test_decoded.wav
voicestudio/__pycache__/
voicestudio/**/__pycache__/

# --- Web app runtime (lives on the Railway volume) -----------------------
web/__pycache__/
web/data/contributions/
web/data/*.db
web/data/*.db-journal

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local

# --- Editor / OS ---------------------------------------------------------
.claude/
.vscode/
.idea/
